# Build output and local state; the image builds these itself.
target/
frontend/node_modules/
frontend/dist/
frontend/node/
frontend/playwright-report/
frontend/test-results/
frontend/*.tsbuildinfo

.git/
.github/
.idea/
.vscode/
data/
*.md
!README.md

# Never copy local secrets into an image.
.env
*.env
*.pem
*.key
*.jks
*.p12
